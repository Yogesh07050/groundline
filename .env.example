# Groundline configuration. Copy to ".env" and fill in your values:
#   cp .env.example .env
# ".env" is git-ignored. Never commit real credentials.

# --- AI provider -------------------------------------------------------------
# Get a key at https://console.groq.com/keys. It stays on the server and is
# never sent to the browser. Without one, the console works but replies are off.
GROQ_API_KEY=your_groq_api_key_here

# Default model; can be overridden in Settings. If you see a "model unavailable"
# error, your key can't use this one. Settings lists the models it can use.
GROQ_MODEL=openai/gpt-oss-120b

# First-run defaults for these two; after that they're edited in Settings.
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=700

# --- Operator account --------------------------------------------------------
# Used only on first run, to create the console login. If ADMIN_PASSWORD is empty,
# a random one is generated and printed once to the server log.
ADMIN_EMAIL=admin@groundline.local
ADMIN_PASSWORD=

# --- Server ------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=data/groundline.db

# Sites allowed to embed the widget: "*" or a comma-separated list of origins.
ALLOWED_ORIGINS=*

# Number of reverse proxies in front of the app, so rate limits see real client IPs.
TRUST_PROXY=0

# Session cookies are Secure by default in production. Only set this to false when
# running a production build over plain http, such as a local Docker test.
# COOKIE_SECURE=false

# --- Abuse protection --------------------------------------------------------
# Per-IP limit on chat messages, within a rolling window.
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=20
